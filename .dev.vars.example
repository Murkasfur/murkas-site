# Скопируй в .dev.vars (он в .gitignore) для локального запуска.
# Официальные тестовые ключи Cloudflare Turnstile: проверка всегда проходит.
# Настоящий виджет работает только на murkas.net, поэтому локально - эти.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
