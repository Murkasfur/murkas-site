{
  "name": "murkas-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply murkas-db --local",
    "db:migrate": "wrangler d1 migrations apply murkas-db --remote",
    "db:seed:local": "node scripts/make-seed.ts && wrangler d1 execute murkas-db --local --file db/seed.sql",
    "db:seed": "node scripts/make-seed.ts && wrangler d1 execute murkas-db --remote --file db/seed.sql",
    "bot:dev": "wrangler dev -c bot/wrangler.jsonc --persist-to .wrangler/state --port 8788",
    "bot:deploy": "wrangler deploy -c bot/wrangler.jsonc",
    "dev:all": "npm run build && wrangler dev -c dist/server/wrangler.json -c bot/wrangler.jsonc --persist-to .wrangler/state"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@fontsource-variable/rubik": "^5.3.0",
    "astro": "^7.4.5",
    "simple-icons": "^16.38.1"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true,
    "workerd@1.20261123.1": true
  }
}
