---
// Плитка загрузки в шапке страницы. Пока бэкенда нет, открывает окно «скоро».
// Перетаскивание файлов на страницу тоже ловится и открывает это окно.
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  hint: string;
}
const { lang, title, hint } = Astro.props;
const t = useTranslations(lang);
---

<button type="button" class="upload-tile" data-open-upload>
  <span class="upload-tile__icon"><Icon name="add_photo" /></span>
  <span class="upload-tile__text">
    <span class="md-title-medium">{title}</span>
    <span class="md-body-small muted">{hint}</span>
  </span>
</button>

<dialog class="dialog" id="upload-dialog" aria-labelledby="upload-title">
  <div class="dialog__inner">
    <div class="dialog__head">
      <h2 id="upload-title" class="md-headline-small">{title}</h2>
      <button type="button" class="icon-btn" data-close aria-label={t('common.close')}><Icon name="close" /></button>
    </div>
    <span class="status-badge">{t('common.soon')}</span>
    <h3 class="md-title-medium">{t('upload.soonTitle')}</h3>
    <p class="md-body-medium muted">{t('upload.soonText')}</p>
    <div class="dialog__actions">
      <a class="md-btn md-btn--filled" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</dialog>

<div class="drop-overlay" aria-hidden="true">
  <div class="drop-overlay__box">
    <Icon name="add_photo" size={40} />
    <span class="md-headline-small">{title}</span>
  </div>
</div>

<script>
  import { openDialog, bindDialog } from '../scripts/dialog';
  const dialog = document.getElementById('upload-dialog') as HTMLDialogElement | null;
  const overlay = document.querySelector<HTMLElement>('.drop-overlay');
  bindDialog(dialog);
  document.querySelectorAll('[data-open-upload]').forEach((b) => b.addEventListener('click', () => dialog && openDialog(dialog)));

  // Зона перетаскивания на весь экран с размытием
  let depth = 0;
  const hasFiles = (e: DragEvent) => Array.from(e.dataTransfer?.types || []).includes('Files');
  window.addEventListener('dragenter', (e) => {
    if (!hasFiles(e)) return;
    depth += 1;
    overlay?.classList.add('is-visible');
  });
  window.addEventListener('dragleave', () => {
    depth = Math.max(0, depth - 1);
    if (!depth) overlay?.classList.remove('is-visible');
  });
  window.addEventListener('dragover', (e) => hasFiles(e) && e.preventDefault());
  window.addEventListener('drop', (e) => {
    if (!hasFiles(e)) return;
    e.preventDefault();
    depth = 0;
    overlay?.classList.remove('is-visible');
    dialog && openDialog(dialog);
  });
</script>

<style>
  .drop-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    padding: 24px;
    background: color-mix(in srgb, var(--md-surface) 55%, transparent);
    backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .drop-overlay.is-visible { opacity: 1; }
  .drop-overlay__box {
    display: grid;
    place-items: center;
    gap: 12px;
    width: min(640px, 100%);
    padding: 64px 24px;
    border: 2px dashed var(--md-primary);
    border-radius: 32px;
    background: var(--md-surface-container-lowest);
    color: var(--md-primary);
  }
</style>
