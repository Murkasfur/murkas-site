---
// Отдельная страница цен: прайс, «не беру», скидка на запуск, условия, подборщик и процесс.
import PfLayout from './PfLayout.astro';
import PfPricing from './PfPricing.astro';
import PfContact from './PfContact.astro';
import { getPortfolio, tx, ui, type Lang } from '../../lib/portfolio';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const pf = await getPortfolio();
const pad = (n: number) => String(n).padStart(2, '0');
---

<PfLayout lang={lang} title={`${t.pricesTitle} · ${pf.profile.name}`} description={t.pricingPageSub}>
  <PfPricing lang={lang} page />

  <section id="process" class="pf-section" aria-labelledby="process-title">
    <h2 id="process-title" class="pf-h2">{t.howTitle}</h2>
    <p class="pf-sub muted">{t.howSub}</p>
    <ol class="pf-steps">
      {pf.process.map((s, i) => (
        <li class={`pf-step pf-step--${i % 3}`}>
          <span class="pf-step__n">{pad(i + 1)}</span>
          <h3>{tx(s.title, lang)}</h3>
          <p class="muted">{tx(s.text, lang)}</p>
        </li>
      ))}
    </ol>
    <p class="pf-note-line muted">{t.noBackend}</p>
  </section>

  <PfContact lang={lang} />
</PfLayout>
