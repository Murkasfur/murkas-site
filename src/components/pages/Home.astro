---
// Главная: бенто-сетка 1-в-1 с макетом в Figma (frame «Главная»).
// Ряд 1: Hero 600 | Мой вайб 240 | Соцсети 328
// Ряд 2: Сейчас 240 | Фурсьюты 600 | Где встретить 328
import Page from '../Page.astro';
import Icon from '../Icon.astro';
import SocialsCard from '../SocialsCard.astro';
import { useTranslations, localizePath, type Lang, type UiKey } from '../../i18n/ui';
import { loc, type EventItem } from '../../data/mock';
import { getEvents } from '../../lib/data';
import { computeNow } from '../../lib/now-core';
import { getWeather, describe, deg } from '../../lib/weather';
import { homeTiles } from '../../lib/media';
import { defaultSettings } from '../../lib/settings-core';
import { socials } from '../../data/site';

const { lang } = Astro.props as { lang: Lang };
const [events, weather] = await Promise.all([getEvents(), getWeather()]);
const nowStatus = computeNow(
  new Date(),
  events.map((e) => ({ ...e, title: { ru: loc(e.title, 'ru'), en: loc(e.title, 'en') } })),
  Astro.locals.settings ?? defaultSettings(),
  weather,
);
const wd = weather && describe(weather);
const t = useTranslations(lang);
const weatherTip = weather && wd ? `${lang === 'ru' ? wd.ru : wd.en}, ${t('home.feels')} ${deg(weather.feels)}` : '';
const locale = lang === 'ru' ? 'ru-RU' : 'en-CA';

const today = new Date().toISOString().slice(0, 10);
const key = (e: EventItem) => e.start ?? e.sortKey ?? '9999';
const upcoming = events.filter((e) => key(e) >= today && e.status !== 'cant').sort((a, b) => key(a).localeCompare(key(b)));
const [next, then] = upcoming;

const day = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString(locale, { day: 'numeric', month: 'short' }).replace('.', '');
const when = (e: EventItem) =>
  (e.start ? (e.end ? `${day(e.start)} - ${day(e.end)}` : day(e.start)) : `≈ ${loc(e.approx, lang)}`) + (e.startTime ? `, ${e.startTime}` : '');
const statusKey = (e: EventItem) => `status.${e.status}` as UiKey;

const telegram = socials.find((s) => s.key === 'telegram')!;
const heroImg = (Astro.locals.settings ?? defaultSettings()).hero;
// «Мой вайб»: трек ставится ботом (/vibe). Без трека диск просто крутится
const vibe = (Astro.locals.settings ?? defaultSettings()).vibe;
const vibeTitle = vibe ? vibe.title || t('home.vibeUntitled') : 'Getting Over You';
const vibeArtist = vibe ? vibe.artist : 'Hot Freaks';
const vibeCover = vibe?.cover ? `/media/${vibe.cover}?w=400` : '/img/vibe-cover.webp';
const tiles = await homeTiles((Astro.locals.settings ?? defaultSettings()).home, lang, [t('home.fsFull'), t('home.fsRide'), t('home.fsBack')]);
---

<Page lang={lang} page="home" title={t('home.title')}>
  <div class="bento">
    <div class="row row--1">
      <!-- Hero -->
      <section class="hero">
        <div class="hero__avatar" aria-hidden="true">
          {heroImg && <img src={`/media/${heroImg}?w=800`} alt="" decoding="async" onerror="this.remove()" />}
        </div>
        <div class="hero__text">
          <div class="hero__info">
            <div class="hero__greet">
              <p class="hero__hello">{t('home.hello')}</p>
              <h1 class="hero__name">{t('home.name')}</h1>
            </div>
            <p class="hero__about">{t('home.about1')}<br />{t('home.about2')}</p>
          </div>
          <div class="hero__actions">
            <a class="hero-btn hero-btn--filled" href={telegram.href} target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20V4l19 8L3 20Zm2-3 11.85-5L5 7v3.5l6 1.5-6 1.5V17Z" /></svg>
              {t('home.write')}
            </a>
            <a class="hero-btn hero-btn--outlined" href={localizePath('/portfolio', lang)}>{t('home.portfolio')}</a>
          </div>
        </div>
      </section>

      <!-- Мой вайб -->
      <section class:list={['vibe', { 'vibe--audio': vibe }]}>
        <h2 class="md-label-large vibe__title">{t('home.vibe')}</h2>
        <button type="button" class="disc" aria-pressed="false" aria-label={[vibeTitle, vibeArtist].filter(Boolean).join(' - ')}>
          {vibe && <span class="disc__ring" aria-hidden="true"></span>}
          <span class="disc__vinyl">
            <img class="disc__cover" src={vibeCover} alt="" width="64" height="64" decoding="async" />
            <span class="disc__spindle"></span>
          </span>
          <span class="disc__sheen"></span>
          <span class="disc__hint">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" /></svg>
            <span class="md-label-large">{t('home.play')}</span>
          </span>
        </button>
        <div class="vibe__track">
          <p class="md-title-small vibe__name">{vibeTitle}</p>
          {vibeArtist && <p class="md-body-small vibe__artist">{vibeArtist}</p>}
        </div>
        {vibe && (
          <div class="vol">
            <button type="button" class="vol__btn" data-vol-mute aria-label={t('home.mute')}>
              <span data-vol-icon="up"><Icon name="volume_up" size={20} /></span>
              <span data-vol-icon="down" hidden><Icon name="volume_down" size={20} /></span>
              <span data-vol-icon="off" hidden><Icon name="volume_off" size={20} /></span>
            </button>
            <div class="vol__slider" style="--v: 0.8">
              <span class="vol__active" aria-hidden="true"></span>
              <span class="vol__inactive" aria-hidden="true"></span>
              <span class="vol__thumb" aria-hidden="true"></span>
              <input type="range" class="vol__range" min="0" max="100" step="1" value="80" data-vol aria-label={t('home.volume')} />
            </div>
          </div>
        )}
        {vibe && <audio data-vibe-audio src={`/audio/${vibe.audio}`} preload="none"></audio>}
      </section>

      <div class="socials-slot"><SocialsCard lang={lang} /></div>
    </div>

    <div class="row row--2">
      <!-- Сейчас: время живое, статус считает src/lib/now-core.ts (расписание, ивенты, сон, праздники, /now), погода - позже -->
      <section class="now">
        <div class="now__head">
          <h2 class="md-label-large now__title">{t('home.now')}</h2>
          {weather && wd && (
            <span class="now__weather md-label-large" title={weatherTip} aria-label={`${t('home.weather')}: ${deg(weather.temp)}, ${weatherTip}`}>
              <span aria-hidden="true">{wd.icon}</span> {deg(weather.temp)}
            </span>
          )}
        </div>
        <div class="now__time">
          <p class="md-headline-large" data-clock>--:--</p>
          <p class="md-body-medium now__date" data-today data-locale={locale}></p>
          <p class="md-body-small now__zone" data-zone data-city={t('home.city')}>{t('home.city')}</p>
        </div>
        <span class="now__chip md-label-large">{nowStatus[lang]}</span>
      </section>

      <!-- Фурсьюты -->
      <section class="fursuits" data-morph-card>
        <div class="card-head">
          <h2 class="md-label-large">{t('home.fursuits')}</h2>
          <a class="head-link md-label-large" href={localizePath('/photos', lang)} data-morph>{t('home.gallery')} <Icon name="arrow_outward" size={16} /></a>
        </div>
        <div class="fursuits__photos">
          {
            tiles.map((tile) =>
              tile.src ? (
                <a class="suit suit--photo" href={`${localizePath('/photos', lang)}?view=${tile.id}`} aria-label={tile.label || t('home.gallery')}>
                  <img class="suit__img" src={tile.src} alt="" loading="lazy" decoding="async" />
                  {tile.label && <span class="suit__chip md-label-large">{tile.label}</span>}
                </a>
              ) : (
                <div class="suit">
                  <Icon name="photo_camera" class="suit__icon" />
                  <span class="suit__chip md-label-large">{tile.label}</span>
                </div>
              ),
            )
          }
        </div>
      </section>

      <!-- Где встретить -->
      <section class="meet" data-morph-card>
        <div class="card-head">
          <h2 class="md-label-large meet__title"><Icon name="event" size={20} /> {t('home.meet')}</h2>
          <a class="head-link md-label-large muted" href={localizePath('/events', lang)} data-morph>{t('home.allShort')} <Icon name="arrow_outward" size={16} /></a>
        </div>
        {
          next && (
            <div class="meet__next">
              {next.start && (
                <p class="md-label-small muted" data-countdown={next.start} data-tpl={t('home.inDays')} data-today={t('home.todayEv')} data-tomorrow={t('home.tomorrow')} />
              )}
              <p class="md-title-large">{next.url ? <a class="meet__link" href={next.url} target="_blank" rel="noopener noreferrer">{loc(next.title, lang)}<Icon name="arrow_outward" size={18} /></a> : loc(next.title, lang)}</p>
              <p class="md-body-small muted meet__where">
                <Icon name="place" size={16} /> {when(next)} · {loc(next.city, lang)}
              </p>
              <span class:list={['ev-status', `ev-status--${next.status}`]}>{t(statusKey(next))}</span>
            </div>
          )
        }
        {
          then && (
            <div class="meet__then">
              <div>
                <p class="md-title-small">{t('home.then')}: {loc(then.title, lang)}</p>
                <p class="md-body-small muted">{then.start ? when(then) : 'TBA'}</p>
              </div>
              <span class:list={['ev-status', `ev-status--${then.status}`]}>{t(statusKey(then))}</span>
            </div>
          )
        }
      </section>
    </div>
  </div>
</Page>

<script>
  // Телефон (вариант «Профиль»): «Сейчас», «Мой вайб» и «Где встретить» - лента со свайпом под шапкой.
  // Карточки переносим, а не копируем: обработчики (часы, звук) остаются на месте.
  {
    const bento = document.querySelector<HTMLElement>('.bento');
    const hero = bento?.querySelector<HTMLElement>('.hero');
    const cards = ['.now', '.vibe', '.meet'].map((sel) => bento?.querySelector<HTMLElement>(sel)).filter((el): el is HTMLElement => !!el);
    if (bento && hero && cards.length) {
      const homes = cards.map((el) => ({ el, parent: el.parentElement!, next: el.nextElementSibling }));
      const rail = document.createElement('div');
      rail.className = 'rail';
      const mq = matchMedia('(max-width: 600px)');
      const place = () => {
        if (mq.matches) {
          hero.after(rail);
          rail.append(...cards);
        } else if (rail.isConnected) {
          for (const h of [...homes].reverse()) h.parent.insertBefore(h.el, h.next && h.next.parentElement === h.parent ? h.next : null);
          rail.remove();
        }
      };
      place();
      mq.addEventListener('change', place);
    }
  }
  // Винил: клик - играет и крутится, ещё клик - пауза.
  // Если трек не поставлен в боте - диск просто крутится без звука.
  const disc = document.querySelector<HTMLButtonElement>('.disc');
  const audio = document.querySelector<HTMLAudioElement>('[data-vibe-audio]');
  if (disc && audio) {
    const set = (on: boolean) => disc.setAttribute('aria-pressed', String(on));
    disc.addEventListener('click', () => {
      if (audio.paused) audio.play().catch(() => set(false));
      else audio.pause();
    });
    audio.addEventListener('play', () => set(true));
    audio.addEventListener('pause', () => set(false));
    audio.addEventListener('waiting', () => disc.classList.add('is-loading'));
    audio.addEventListener('playing', () => disc.classList.remove('is-loading'));
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) disc.style.setProperty('--p', String(audio.currentTime / audio.duration));
    });
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      disc.style.setProperty('--p', '0');
    });
    audio.addEventListener('error', () => {
      set(false);
      disc.classList.remove('is-loading');
    });

    // Громкость: ползунок + кнопка «без звука», запоминаем в браузере
    const range = document.querySelector<HTMLInputElement>('[data-vol]');
    const mute = document.querySelector<HTMLButtonElement>('[data-vol-mute]');
    const KEY = 'murkas-volume';
    let last = 0.8; // к чему вернуться после «без звука»
    const apply = (v: number, save = true) => {
      v = Math.min(1, Math.max(0, v));
      audio.volume = v;
      if (v > 0) last = v;
      if (range) {
        range.value = String(Math.round(v * 100));
        range.parentElement?.style.setProperty('--v', String(v));
      }
      const icon = v === 0 ? 'off' : v < 0.5 ? 'down' : 'up';
      document.querySelectorAll<HTMLElement>('[data-vol-icon]').forEach((el) => (el.hidden = el.dataset.volIcon !== icon));
      mute?.setAttribute('aria-pressed', String(v === 0));
      if (save) {
        try {
          localStorage.setItem(KEY, String(v));
        } catch {
          /* приватный режим - не запоминаем */
        }
      }
    };
    let saved = NaN;
    try {
      saved = parseFloat(localStorage.getItem(KEY) ?? '');
    } catch {
      /* нет доступа к хранилищу */
    }
    apply(Number.isFinite(saved) ? saved : 0.8, false);
    range?.addEventListener('input', () => apply(+range.value / 100));
    mute?.addEventListener('click', () => apply(audio.volume > 0 ? 0 : last || 0.8));
  } else if (disc) {
    disc.addEventListener('click', () => disc.setAttribute('aria-pressed', String(disc.getAttribute('aria-pressed') !== 'true')));
  }

  // Живые часы по Торонто
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const zone = document.querySelector<HTMLElement>('[data-zone]');
  const tick = () => {
    const now = new Date();
    if (clock) clock.textContent = now.toLocaleTimeString('ru-RU', { timeZone: 'America/Toronto', hour: '2-digit', minute: '2-digit' });
    if (zone) {
      const offset = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Toronto', timeZoneName: 'shortOffset' })
        .formatToParts(now)
        .find((p) => p.type === 'timeZoneName')
        ?.value.replace('GMT', 'UTC')
        .replace('-', '−');
      zone.textContent = `${zone.dataset.city} · ${offset}`;
    }
  };
  // Дата по Торонто: «ср, 25 ноября»
  const today = document.querySelector<HTMLElement>('[data-today]');
  const tickDate = () => {
    if (!today) return;
    const s = new Date().toLocaleDateString(today.dataset.locale, { timeZone: 'America/Toronto', weekday: 'short', day: 'numeric', month: 'long' });
    today.textContent = s.replace('.', '');
  };
  tick();
  tickDate();
  setInterval(() => {
    tick();
    tickDate();
  }, 15_000);

  // «Через N дней» считается в браузере, чтобы не зависеть от даты сборки
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
    const d = el.dataset;
    const days = Math.round((new Date(`${d.countdown}T00:00:00`).getTime() - new Date(new Date().toDateString()).getTime()) / 864e5);
    el.textContent = days <= 0 ? d.today! : days === 1 ? d.tomorrow! : d.tpl!.replace('{n}', String(days));
  });
</script>

<style>
  .bento { display: flex; flex-direction: column; gap: 24px; }
  .row { display: grid; gap: 24px; }
  .row--1 { grid-template-columns: 600fr 240fr 328fr; }
  .row--2 { grid-template-columns: 240fr 600fr 328fr; }
  .socials-slot { display: grid; }
  .socials-slot :global(.socials) { border-width: 3px; border-radius: 32px; padding: 20px; }

  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .head-link { display: inline-flex; align-items: center; gap: 4px; text-decoration: none; }

  /* ---------- Hero ---------- */
  .hero {
    display: flex;
    gap: 28px;
    padding: 28px;
    border: 7px solid var(--md-on-secondary-fixed);
    border-radius: 32px;
    background: var(--md-secondary);
    color: var(--md-on-secondary);
  }
  .hero__avatar {
    position: relative;
    /* шире и ниже: ряд не растягивается в высоту, фото ближе к квадрату */
    flex: 0 1 180px;
    min-width: 120px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--md-secondary-container);
  }
  .hero__avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__text { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 20px; min-width: 0; }
  .hero__info { display: flex; flex-direction: column; gap: 14px; }
  .hero__greet { display: flex; flex-direction: column; gap: 6px; }
  .hero__hello { font: 400 18px/24px var(--font-plain); }
  .hero__name { font: 700 56px/60px var(--font-brand); color: var(--md-tertiary-fixed); letter-spacing: -0.5px; }
  .hero__about { font: 400 17px/24px var(--font-plain); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font: 500 15px/22px var(--font-plain);
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.15s, background-color 0.15s;
  }
  .hero-btn--filled { background: var(--md-primary); color: var(--md-on-primary); }
  .hero-btn--filled:hover { filter: brightness(1.08); }
  .hero-btn--outlined { border: 1.5px solid var(--md-on-secondary); color: var(--md-on-secondary); }
  .hero-btn--outlined:hover { background: color-mix(in srgb, var(--md-on-secondary) 10%, transparent); }

  /* ---------- Мой вайб ---------- */
  .vibe {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 18px 20px;
    border: 3px solid var(--md-primary-fixed-dim);
    border-radius: 33px;
    background: var(--md-primary-fixed);
    color: var(--md-on-primary-fixed);
  }
  .vibe__title { align-self: stretch; }
  .vibe__track { text-align: center; max-width: 100%; }
  .vibe__artist { color: var(--md-on-primary-fixed-variant); }

  .disc {
    position: relative;
    width: 148px;
    height: 148px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
  }
  .disc:focus-visible { outline: 3px solid var(--md-primary); outline-offset: 4px; }
  .disc__vinyl {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, transparent 0 2px, rgb(255 255 255 / 0.05) 2px 2.6px),
      #1b1c1a;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
    animation: spin 3s linear infinite;
    animation-play-state: paused;
  }
  .disc__cover {
    grid-area: 1 / 1;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px rgb(27 28 26 / 0.6);
  }
  .disc__spindle {
    grid-area: 1 / 1;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--md-surface);
    box-shadow: 0 0 0 1px #1b1c1a;
  }
  .disc__sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 30deg, transparent 0 12%, rgb(255 255 255 / 0.12) 18%, transparent 26% 62%, rgb(255 255 255 / 0.08) 68%, transparent 76%);
    pointer-events: none;
  }
  .disc__hint {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(27 28 26 / 0.5);
    color: #fff;
    transition: opacity 0.25s;
  }
  .disc:hover .disc__hint,
  .disc[aria-pressed='true'] .disc__hint { opacity: 0; }
  .disc[aria-pressed='true'] .disc__vinyl { animation-play-state: running; }
  @keyframes spin { to { transform: rotate(360deg); } }
  /* Кольцо прогресса вокруг диска: --p от 0 до 1 ставит скрипт */
  .disc__ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: conic-gradient(var(--md-primary) calc(var(--p, 0) * 360deg), rgb(27 28 26 / 0.12) 0);
    mask: radial-gradient(circle, transparent calc(50% - 3px), #000 calc(50% - 2.5px));
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .disc[aria-pressed='true'] .disc__ring,
  .disc[style*='--p'] .disc__ring { opacity: 1; }
  .disc.is-loading .disc__ring { animation: pulse 1s ease-in-out infinite alternate; }
  @keyframes pulse { from { opacity: 0.35; } to { opacity: 1; } }
  /* С треком диск чуть меньше, чтобы под ним поместилась громкость */
  .vibe--audio { gap: 6px; padding-bottom: 14px; }
  .vibe--audio .disc { width: 136px; height: 136px; }

  /* ---------- Громкость: слайдер Material 3 (дорожка 16px, ручка-палочка с зазором, точка на конце) ---------- */
  .vol { display: flex; align-items: center; gap: 6px; align-self: stretch; }
  .vol__btn {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--md-on-primary-fixed-variant);
    cursor: pointer;
  }
  .vol__btn:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .vol__btn:focus-visible { outline: 2px solid var(--md-primary); outline-offset: 1px; }
  /* Сам ползунок рисуем span'ами (две дорожки + ручка), а настоящий <input type=range>
     лежит сверху прозрачным - он отвечает за мышь, тач и клавиатуру */
  .vol__slider {
    --active: var(--md-primary);
    --inactive: var(--md-primary-fixed-dim);
    /* центр ручки: от 2px до (ширина - 2px) - так же ходит ручка 4px у настоящего input */
    --x: calc(var(--v, 0.8) * (100% - 4px) + 2px);
    position: relative;
    flex: 1;
    min-width: 0;
    height: 28px;
  }
  .vol__active,
  .vol__inactive {
    position: absolute;
    top: 6px;
    height: 16px;
