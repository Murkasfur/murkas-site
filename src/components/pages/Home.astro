---
// Главная: бенто-сетка 1-в-1 с макетом в Figma (frame «Главная»).
// Ряд 1: Hero 600 | Мой вайб 240 | Соцсети 328
// Ряд 2: Сейчас 240 | Фурсьюты 600 | Где встретить 328
import Page from '../Page.astro';
import Icon from '../Icon.astro';
import SocialsCard from '../SocialsCard.astro';
import { useTranslations, localizePath, type Lang, type UiKey } from '../../i18n/ui';
import { loc, type EventItem } from '../../data/mock';
import { getEvents } from '../../lib/data';
import { computeNow } from '../../lib/now-core';
import { homeTiles } from '../../lib/media';
import { defaultSettings } from '../../lib/settings-core';
import { socials } from '../../data/site';

const { lang } = Astro.props as { lang: Lang };
const events = await getEvents();
const nowStatus = computeNow(
  new Date(),
  events.map((e) => ({ ...e, title: { ru: loc(e.title, 'ru'), en: loc(e.title, 'en') } })),
  Astro.locals.settings ?? defaultSettings(),
);
const t = useTranslations(lang);
const locale = lang === 'ru' ? 'ru-RU' : 'en-CA';

const today = new Date().toISOString().slice(0, 10);
const key = (e: EventItem) => e.start ?? e.sortKey ?? '9999';
const upcoming = events.filter((e) => key(e) >= today && e.status !== 'cant').sort((a, b) => key(a).localeCompare(key(b)));
const [next, then] = upcoming;

const day = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString(locale, { day: 'numeric', month: 'short' }).replace('.', '');
const when = (e: EventItem) =>
  (e.start ? (e.end ? `${day(e.start)} - ${day(e.end)}` : day(e.start)) : `≈ ${loc(e.approx, lang)}`) + (e.startTime ? `, ${e.startTime}` : '');
const statusKey = (e: EventItem) => `status.${e.status}` as UiKey;

const telegram = socials.find((s) => s.key === 'telegram')!;
const tiles = await homeTiles((Astro.locals.settings ?? defaultSettings()).home, lang, [t('home.fsFull'), t('home.fsRide'), t('home.fsBack')]);
---

<Page lang={lang} page="home" title={t('home.title')}>
  <div class="bento">
    <div class="row row--1">
      <!-- Hero -->
      <section class="hero">
        <div class="hero__avatar" aria-hidden="true"></div>
        <div class="hero__text">
          <div class="hero__info">
            <div class="hero__greet">
              <p class="hero__hello">{t('home.hello')}</p>
              <h1 class="hero__name">{t('home.name')}</h1>
            </div>
            <p class="hero__about">{t('home.about1')}<br />{t('home.about2')}</p>
          </div>
          <div class="hero__actions">
            <a class="hero-btn hero-btn--filled" href={telegram.href} target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20V4l19 8L3 20Zm2-3 11.85-5L5 7v3.5l6 1.5-6 1.5V17Z" /></svg>
              {t('home.write')}
            </a>
            <a class="hero-btn hero-btn--outlined" href={localizePath('/portfolio', lang)}>{t('home.portfolio')}</a>
          </div>
        </div>
      </section>

      <!-- Мой вайб -->
      <section class="vibe">
        <h2 class="md-label-large vibe__title">{t('home.vibe')}</h2>
        <button type="button" class="disc" aria-pressed="false" aria-label="Getting Over You - Hot Freaks">
          <span class="disc__vinyl">
            <img class="disc__cover" src="/img/vibe-cover.webp" alt="" width="64" height="64" decoding="async" />
            <span class="disc__spindle"></span>
          </span>
          <span class="disc__sheen"></span>
          <span class="disc__hint">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" /></svg>
            <span class="md-label-large">{t('home.play')}</span>
          </span>
        </button>
        <div class="vibe__track">
          <p class="md-title-small">Getting Over You</p>
          <p class="md-body-small vibe__artist">Hot Freaks</p>
        </div>
      </section>

      <div class="socials-slot"><SocialsCard lang={lang} /></div>
    </div>

    <div class="row row--2">
      <!-- Сейчас: время живое, статус считает src/lib/now-core.ts (расписание, ивенты, сон, праздники, /now), погода - позже -->
      <section class="now">
        <h2 class="md-label-large now__title">{t('home.now')}</h2>
        <div class="now__time">
          <p class="md-headline-large" data-clock>--:--</p>
          <p class="md-body-small now__zone" data-zone data-city={t('home.city')}>{t('home.city')}</p>
        </div>
        <span class="now__chip md-label-large">{nowStatus[lang]}</span>
      </section>

      <!-- Фурсьюты -->
      <section class="fursuits" data-morph-card>
        <div class="card-head">
          <h2 class="md-label-large">{t('home.fursuits')}</h2>
          <a class="head-link md-label-large" href={localizePath('/photos', lang)} data-morph>{t('home.gallery')} <Icon name="arrow_outward" size={16} /></a>
        </div>
        <div class="fursuits__photos">
          {
            tiles.map((tile) =>
              tile.src ? (
                <a class="suit suit--photo" href={`${localizePath('/photos', lang)}?view=${tile.id}`} aria-label={tile.label || t('home.gallery')}>
                  <img class="suit__img" src={tile.src} alt="" loading="lazy" decoding="async" />
                  {tile.label && <span class="suit__chip md-label-large">{tile.label}</span>}
                </a>
              ) : (
                <div class="suit">
                  <Icon name="photo_camera" class="suit__icon" />
                  <span class="suit__chip md-label-large">{tile.label}</span>
                </div>
              ),
            )
          }
        </div>
      </section>

      <!-- Где встретить -->
      <section class="meet" data-morph-card>
        <div class="card-head">
          <h2 class="md-label-large meet__title"><Icon name="event" size={20} /> {t('home.meet')}</h2>
          <a class="head-link md-label-large muted" href={localizePath('/events', lang)} data-morph>{t('home.allShort')} <Icon name="arrow_outward" size={16} /></a>
        </div>
        {
          next && (
            <div class="meet__next">
              {next.start && (
                <p class="md-label-small muted" data-countdown={next.start} data-tpl={t('home.inDays')} data-today={t('home.todayEv')} data-tomorrow={t('home.tomorrow')} />
              )}
              <p class="md-title-large">{next.url ? <a class="meet__link" href={next.url} target="_blank" rel="noopener noreferrer">{loc(next.title, lang)}<Icon name="arrow_outward" size={18} /></a> : loc(next.title, lang)}</p>
              <p class="md-body-small muted meet__where">
                <Icon name="place" size={16} /> {when(next)} · {loc(next.city, lang)}
              </p>
              <span class:list={['ev-status', `ev-status--${next.status}`]}>{t(statusKey(next))}</span>
            </div>
          )
        }
        {
          then && (
            <div class="meet__then">
              <div>
                <p class="md-title-small">{t('home.then')}: {loc(then.title, lang)}</p>
                <p class="md-body-small muted">{then.start ? when(then) : 'TBA'}</p>
              </div>
              <span class:list={['ev-status', `ev-status--${then.status}`]}>{t(statusKey(then))}</span>
            </div>
          )
        }
      </section>
    </div>
  </div>
</Page>

<script>
  // Винил: клик - крутится, ещё клик - останавливается
  document.querySelectorAll<HTMLButtonElement>('.disc').forEach((d) =>
    d.addEventListener('click', () => d.setAttribute('aria-pressed', String(d.getAttribute('aria-pressed') !== 'true'))),
  );

  // Живые часы по Торонто
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const zone = document.querySelector<HTMLElement>('[data-zone]');
  const tick = () => {
    const now = new Date();
    if (clock) clock.textContent = now.toLocaleTimeString('ru-RU', { timeZone: 'America/Toronto', hour: '2-digit', minute: '2-digit' });
    if (zone) {
      const offset = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Toronto', timeZoneName: 'shortOffset' })
        .formatToParts(now)
        .find((p) => p.type === 'timeZoneName')
        ?.value.replace('GMT', 'UTC')
        .replace('-', '−');
      zone.textContent = `${zone.dataset.city} · ${offset}`;
    }
  };
  tick();
  setInterval(tick, 15_000);

  // «Через N дней» считается в браузере, чтобы не зависеть от даты сборки
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
    const d = el.dataset;
    const days = Math.round((new Date(`${d.countdown}T00:00:00`).getTime() - new Date(new Date().toDateString()).getTime()) / 864e5);
    el.textContent = days <= 0 ? d.today! : days === 1 ? d.tomorrow! : d.tpl!.replace('{n}', String(days));
  });
</script>

<style>
  .bento { display: flex; flex-direction: column; gap: 24px; }
  .row { display: grid; gap: 24px; }
  .row--1 { grid-template-columns: 600fr 240fr 328fr; }
  .row--2 { grid-template-columns: 240fr 600fr 328fr; }
  .socials-slot { display: grid; }
  .socials-slot :global(.socials) { border-width: 3px; border-radius: 32px; padding: 20px; }

  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .head-link { display: inline-flex; align-items: center; gap: 4px; text-decoration: none; }

  /* ---------- Hero ---------- */
  .hero {
    display: flex;
    gap: 32px;
    padding: 36px;
    border: 7px solid var(--md-on-secondary-fixed);
    border-radius: 32px;
    background: var(--md-secondary);
    color: var(--md-on-secondary);
  }
  .hero__avatar {
    flex: 0 1 179px;
    min-width: 120px;
    border-radius: 16px;
    background: var(--md-secondary-container);
  }
  .hero__text { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 28px; min-width: 0; }
  .hero__info { display: flex; flex-direction: column; gap: 22px; }
  .hero__greet { display: flex; flex-direction: column; gap: 6px; }
  .hero__hello { font: 400 18px/24px var(--font-plain); }
  .hero__name { font: 700 60px/64px var(--font-brand); color: var(--md-tertiary-fixed); letter-spacing: -0.5px; }
  .hero__about { font: 400 18px/26px var(--font-plain); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 43px;
    padding: 0 20px;
    border-radius: 999px;
    font: 500 18px/24px var(--font-plain);
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.15s, background-color 0.15s;
  }
  .hero-btn--filled { background: var(--md-primary); color: var(--md-on-primary); }
  .hero-btn--filled:hover { filter: brightness(1.08); }
  .hero-btn--outlined { border: 1.5px solid var(--md-on-secondary); color: var(--md-on-secondary); }
  .hero-btn--outlined:hover { background: color-mix(in srgb, var(--md-on-secondary) 10%, transparent); }

  /* ---------- Мой вайб ---------- */
  .vibe {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 18px 20px;
    border: 3px solid var(--md-primary-fixed-dim);
    border-radius: 33px;
    background: var(--md-primary-fixed);
    color: var(--md-on-primary-fixed);
  }
  .vibe__title { align-self: stretch; }
  .vibe__track { text-align: center; }
  .vibe__artist { color: var(--md-on-primary-fixed-variant); }

  .disc {
    position: relative;
    width: 148px;
    height: 148px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
  }
  .disc:focus-visible { outline: 3px solid var(--md-primary); outline-offset: 4px; }
  .disc__vinyl {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, transparent 0 2px, rgb(255 255 255 / 0.05) 2px 2.6px),
      #1b1c1a;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
    animation: spin 3s linear infinite;
    animation-play-state: paused;
  }
  .disc__cover {
    grid-area: 1 / 1;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px rgb(27 28 26 / 0.6);
  }
  .disc__spindle {
    grid-area: 1 / 1;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--md-surface);
    box-shadow: 0 0 0 1px #1b1c1a;
  }
  .disc__sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 30deg, transparent 0 12%, rgb(255 255 255 / 0.12) 18%, transparent 26% 62%, rgb(255 255 255 / 0.08) 68%, transparent 76%);
    pointer-events: none;
  }
  .disc__hint {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(27 28 26 / 0.5);
    color: #fff;
    transition: opacity 0.25s;
  }
  .disc:hover .disc__hint,
  .disc[aria-pressed='true'] .disc__hint { opacity: 0; }
  .disc[aria-pressed='true'] .disc__vinyl { animation-play-state: running; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ---------- Сейчас ---------- */
  .now {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    min-height: 240px;
    padding: 22px 24px;
    border: 3px solid var(--md-tertiary-fixed-dim);
    border-radius: 32px;
    background: var(--md-tertiary-fixed);
    color: var(--md-on-tertiary-fixed);
  }
  .now__title, .now__zone { color: var(--md-on-tertiary-fixed-variant); }
  .now__time { display: grid; gap: 2px; }
  .now__chip {
    width: fit-content;
    max-width: 100%;
    padding: 6px 12px;
    /* 16px = пилюля на одной строке и аккуратная плашка, если статус длинный и переносится */
    border-radius: 16px;
    overflow-wrap: anywhere;
    background: var(--md-tertiary-fixed-dim);
  }

  /* ---------- Фурсьюты ---------- */
  .fursuits {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px;
    border-radius: 32px;
    background: var(--md-inverse-surface);
    color: var(--md-inverse-on-surface);
  }
  .fursuits__photos { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; min-height: 164px; }
  .suit {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 0 12px 12px;
    border-radius: 20px;
    background: var(--md-outline);
  }
  .suit--photo { overflow: hidden; text-decoration: none; }
  .suit__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }
  .suit--photo:hover .suit__img { transform: scale(1.04); }
  .suit--photo:focus-visible { outline: 3px solid var(--md-tertiary-container); outline-offset: 2px; }
  .suit :global(.suit__icon) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--md-inverse-on-surface);
  }
  .suit__chip {
    position: relative;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--md-inverse-surface);
    color: var(--md-inverse-on-surface);
    white-space: nowrap;
  }

  /* ---------- Где встретить ---------- */
  .meet {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding: 22px 24px;
    border: 3px solid var(--md-outline-variant);
    border-radius: 32px;
    background: var(--md-surface-container-lowest);
  }
  .meet__title { display: inline-flex; align-items: center; gap: 8px; }
  .meet__link { display: inline-flex; align-items: center; gap: 4px; color: inherit; text-decoration: none; }
  .meet__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .meet__next { display: flex; flex-direction: column; gap: 4px; }
  .meet__next .ev-status { margin-top: 6px; }
  .meet__where { display: inline-flex; align-items: center; gap: 4px; }
  .meet__then {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--md-outline-variant);
  }
  .ev-status {
    width: fit-content;
    padding: 4px 10px;
    border-radius: 999px;
    font: 500 11px/16px var(--font-plain);
    letter-spacing: 0.5px;
    white-space: nowrap;
    background: var(--md-surface-container-highest);
    color: var(--md-on-surface-variant);
  }
  .ev-status--full { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
  .ev-status--partial { background: var(--md-primary-fixed); color: var(--md-on-primary-fixed-variant); }


  /* ---------- Тёмная тема: «fixed»-цвета светлые, поэтому карточки берут тёмные пары ---------- */
  :global(html[data-mode='dark']) .hero {
    background: var(--md-on-secondary-fixed);
    border-color: color-mix(in srgb, var(--md-secondary) 45%, transparent);
    color: var(--md-on-surface);
  }
  :global(html[data-mode='dark']) .hero__avatar { background: color-mix(in srgb, var(--md-secondary) 22%, transparent); }
  :global(html[data-mode='dark']) .hero-btn--outlined { border-color: var(--md-outline); color: var(--md-on-surface); }
  :global(html[data-mode='dark']) .hero-btn--outlined:hover { background: color-mix(in srgb, var(--md-on-surface) 8%, transparent); }

  :global(html[data-mode='dark']) .vibe {
    background: var(--md-on-primary-fixed);
    border-color: var(--md-on-primary-fixed-variant);
    color: var(--md-primary-fixed);
  }
  :global(html[data-mode='dark']) .vibe__artist { color: var(--md-primary-fixed-dim); }

  :global(html[data-mode='dark']) .now {
    background: var(--md-on-tertiary-fixed);
    border-color: var(--md-on-tertiary-fixed-variant);
    color: var(--md-tertiary-fixed);
  }
  :global(html[data-mode='dark']) .now__title,
  :global(html[data-mode='dark']) .now__zone { color: var(--md-tertiary-fixed-dim); }
  :global(html[data-mode='dark']) .now__chip { background: var(--md-on-tertiary-fixed-variant); color: var(--md-tertiary-fixed); }

  :global(html[data-mode='dark']) .fursuits { background: var(--md-surface-container-high); color: var(--md-on-surface); }
  :global(html[data-mode='dark']) .suit { background: var(--md-surface-container-highest); }
  :global(html[data-mode='dark']) .suit :global(.suit__icon) { color: var(--md-on-surface-variant); }
  :global(html[data-mode='dark']) .suit__chip { background: var(--md-surface-container); color: var(--md-on-surface); }
  :global(html[data-mode='dark']) .ev-status--partial { background: var(--md-on-primary-fixed-variant); color: var(--md-primary-fixed); }

  /* ---------- Адаптив ---------- */
  @media (max-width: 1180px) {
    .row--1, .row--2 { grid-template-columns: 1fr 1fr; }
    .hero, .fursuits { grid-column: 1 / -1; }
    .row--2 .fursuits { order: -1; }
  }
  @media (max-width: 680px) {
    .row--1, .row--2 { grid-template-columns: 1fr; }
    .hero { flex-direction: column; padding: 24px; border-width: 5px; }
    .hero__avatar { flex-basis: 200px; }
    .hero__name { font-size: 48px; line-height: 52px; }
    .fursuits__photos { grid-template-columns: 1fr 1fr; }
    .fursuits__photos .suit:last-child { grid-column: 1 / -1; min-height: 140px; }
  }
</style>
