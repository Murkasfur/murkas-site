---
// Важная дата на таймлайне ивентов (ДР, праздник) - Assist chip из M3 (Figma: компонент «Important date»).
// Не ивент: без плитки, статуса и фото. В сам день - лаймовая, как пилюля «Сегодня».
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { loc } from '../data/mock';
import { eventFormat } from '../lib/event-format';
import type { SpecialDate } from '../lib/special-dates';

interface Props {
  d: SpecialDate;
  lang: Lang;
}
const { d, lang } = Astro.props;
const t = useTranslations(lang);
const f = eventFormat(lang);
const when = d.isToday
  ? t('events.dateToday')
  : d.hasDay
    ? f.fmt(d.date, { day: 'numeric', month: 'long' })
    : f.fmt(`${d.date.slice(0, 7)}-01`, { month: 'long' });
---

<li class="sd" data-special>
  <span class:list={['sd__chip', 'md-label-large', { 'sd__chip--today': d.isToday }]}>
    <Icon name={d.icon} size={18} />
    {loc(d.name, lang)} · {when}
  </span>
</li>

<style>
  .sd { display: flex; }
  .sd[hidden] { display: none; }
  .sd__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 6px 16px 6px 8px;
    border: 1px solid var(--md-outline-variant);
    border-radius: 8px;
    color: var(--md-on-surface);
  }
  .sd__chip :global(svg) { flex: none; color: var(--md-primary); }
  .sd__chip--today {
    border-color: transparent;
    background: var(--md-tertiary-fixed, #c4f267);
    color: var(--md-on-tertiary-fixed, #141f00);
  }
  .sd__chip--today :global(svg) { color: inherit; }
</style>
