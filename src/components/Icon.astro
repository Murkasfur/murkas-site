const brands = { telegram: siTelegram, discord: siDiscord, tiktok: siTiktok, youtube: siYoutube, x: siX };

export type IconName = keyof typeof material | keyof typeof brands;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const path = name in brands ? brands[name as keyof typeof brands].path : material[name as keyof typeof material];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={path} />
</svg>
